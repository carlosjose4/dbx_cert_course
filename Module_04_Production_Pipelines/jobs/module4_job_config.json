{
  "name": "globalmart_daily_etl",
  "description": "Daily ETL pipeline for GlobalMart retail data processing with quality validation",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "email_notifications": {
    "on_start": ["data-team@globalmart.com"],
    "on_success": ["data-team@globalmart.com"],
    "on_failure": ["data-team@globalmart.com", "oncall@globalmart.com"],
    "no_alert_for_skipped_runs": true
  },
  "webhook_notifications": {
    "on_failure": [
      {
        "id": "slack_webhook",
        "url": "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
      }
    ]
  },
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "etl_cluster",
      "new_cluster": {
        "spark_version": "13.3.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "autoscale": {
          "min_workers": 2,
          "max_workers": 8
        },
        "spark_conf": {
          "spark.sql.adaptive.enabled": "true",
          "spark.sql.adaptive.coalescePartitions.enabled": "true",
          "spark.sql.adaptive.skewJoin.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true",
          "spark.databricks.delta.optimizeWrite.enabled": "true"
        },
        "spark_env_vars": {
          "ENVIRONMENT": "PRODUCTION"
        },
        "init_scripts": [],
        "cluster_log_conf": {
          "dbfs": {
            "destination": "dbfs:/cluster-logs/globalmart_etl"
          }
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "validate_sources",
      "description": "Validate data source availability and quality",
      "job_cluster_key": "etl_cluster",
      "notebook_task": {
        "notebook_path": "/Module_04_Production_Pipelines/jobs/01_validate_sources",
        "base_parameters": {
          "processing_date": "{{job.start_time | date: '%Y-%m-%d'}}",
          "min_records_threshold": "1000"
        }
      },
      "timeout_seconds": 600,
      "max_retries": 2,
      "retry_on_timeout": true,
      "min_retry_interval_millis": 30000,
      "max_retry_interval_millis": 120000
    },
    {
      "task_key": "bronze_ingestion",
      "description": "Ingest raw data to Bronze layer with minimal transformations",
      "job_cluster_key": "etl_cluster",
      "depends_on": [
        {
          "task_key": "validate_sources"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Module_04_Production_Pipelines/jobs/02_bronze_ingestion",
        "base_parameters": {
          "processing_date": "{{job.start_time | date: '%Y-%m-%d'}}",
          "batch_size": "10000"
        }
      },
      "timeout_seconds": 1800,
      "max_retries": 3,
      "retry_on_timeout": true
    },
    {
      "task_key": "silver_transformation",
      "description": "Transform and clean data for Silver layer",
      "job_cluster_key": "etl_cluster",
      "depends_on": [
        {
          "task_key": "bronze_ingestion"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Module_04_Production_Pipelines/jobs/03_silver_transformation",
        "base_parameters": {
          "processing_date": "{{job.start_time | date: '%Y-%m-%d'}}",
          "quality_threshold": "0.95"
        }
      },
      "timeout_seconds": 2400,
      "max_retries": 2,
      "retry_on_timeout": true
    },
    {
      "task_key": "gold_aggregation",
      "description": "Create business-ready Gold layer aggregations",
      "job_cluster_key": "etl_cluster",
      "depends_on": [
        {
          "task_key": "silver_transformation"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Module_04_Production_Pipelines/jobs/04_gold_aggregation",
        "base_parameters": {
          "processing_date": "{{job.start_time | date: '%Y-%m-%d'}}",
          "aggregation_window_days": "30"
        }
      },
      "timeout_seconds": 1800,
      "max_retries": 2,
      "retry_on_timeout": true
    },
    {
      "task_key": "quality_validation",
      "description": "Validate data quality across all layers",
      "job_cluster_key": "etl_cluster",
      "depends_on": [
        {
          "task_key": "gold_aggregation"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Module_04_Production_Pipelines/jobs/05_quality_validation",
        "base_parameters": {
          "processing_date": "{{job.start_time | date: '%Y-%m-%d'}}",
          "alert_threshold": "0.95"
        }
      },
      "timeout_seconds": 900,
      "max_retries": 1,
      "retry_on_timeout": false
    },
    {
      "task_key": "send_notification",
      "description": "Send completion notification with metrics",
      "job_cluster_key": "etl_cluster",
      "depends_on": [
        {
          "task_key": "quality_validation",
          "outcome": "ALL_DONE"
        }
      ],
      "python_wheel_task": {
        "package_name": "notification_handler",
        "entry_point": "send_summary",
        "parameters": [
          "--processing_date",
          "{{job.start_time | date: '%Y-%m-%d'}}",
          "--job_run_id",
          "{{job.run_id}}"
        ]
      },
      "timeout_seconds": 300,
      "max_retries": 1
    }
  ],
  "run_as": {
    "user_name": "data-engineering-service@globalmart.com"
  },
  "access_control_list": [
    {
      "user_name": "data-team@globalmart.com",
      "permission_level": "CAN_MANAGE"
    },
    {
      "group_name": "data-analysts",
      "permission_level": "CAN_VIEW"
    }
  ],
  "tags": {
    "project": "GlobalMart",
    "environment": "production",
    "team": "data-engineering",
    "cost-center": "DE-001",
    "sla": "critical"
  },
  "format": "MULTI_TASK",
  "queue": {
    "enabled": true,
    "max_queue_size": 10
  },
  "health": {
    "rules": [
      {
        "metric": "RUN_DURATION_SECONDS",
        "op": "GREATER_THAN",
        "value": 7200
      }
    ]
  },
  "git_source": {
    "git_url": "https://github.com/globalmart/data-pipelines",
    "git_branch": "main",
    "git_provider": "github"
  },
  "parameters": [
    {
      "name": "processing_date",
      "default": "{{job.start_time | date: '%Y-%m-%d'}}"
    },
    {
      "name": "environment",
      "default": "production"
    },
    {
      "name": "debug_mode",
      "default": "false"
    }
  ]
}